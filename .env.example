# Environnement d'exécution : production | development
FLASK_ENV=production

# Clé secrète des sessions (obligatoire en production, ex : openssl rand -hex 32)
SECRET_KEY=change-me-with-a-long-random-string

# Base de données : SQLite (defaut) ou PostgreSQL
# SQLite  :
DATABASE_URL=sqlite:///instance/foyz.db
# Postgres :
# DATABASE_URL=postgresql+psycopg2://foyz:foyz@db:5432/foyz

# Mot de passe administrateur initial (utilise a l'initialisation de la base)
ADMIN_PASSWORD=admin

# Passer les cookies de session en Secure (activer derriere HTTPS)
HTTPS_ONLY=0

# Dossier de stockage des fichiers televerses (affiches, logos, PDF, photos)
# UPLOAD_DIR=/data/uploads
