# Environnement d'exécution : production | development
FLASK_ENV=production

# Clé secrète des sessions — OBLIGATOIRE en production (32 caractères minimum)
# Générer avec : openssl rand -hex 32
# Vide : valeur de développement utilisée localement, refusée en production.
SECRET_KEY=

# Base de données : SQLite (defaut) ou PostgreSQL
# SQLite  :
DATABASE_URL=sqlite:///instance/foyz.db
# Postgres (deploiement systemd, voir README option B) :
# DATABASE_URL=postgresql+psycopg2://foyz:<mot de passe>@localhost:5432/foyz

# Mot de passe PostgreSQL — Docker Compose uniquement (inséré dans DATABASE_URL,
# préférer un mot de passe alphanumérique)
POSTGRES_PASSWORD=

# Mot de passe administrateur initial — OBLIGATOIRE en production
# (utilisé à l'initialisation de la base ; « admin » est refusé en production)
ADMIN_PASSWORD=

# Cookies de session « Secure » — OBLIGATOIRE en production derrière HTTPS/Cloudflare
# (laisser 0 uniquement en développement local ou sur un réseau interne sans HTTPS)
HTTPS_ONLY=0

# Dossier de stockage des fichiers televerses (affiches, logos, PDF, photos)
# UPLOAD_DIR=/data/uploads

# IP client derrière proxy (limiteur de connexion, journaux) :
#   TRUSTED_PROXY=cloudflare : lit CF-Connecting-IP (origine injoignable en direct
#     — pare-feu Cloudflare ou Tunnel — sinon l'en-tête est falsifiable)
#   PROXY_FIX_X_FOR=1 : fait confiance au dernier relais X-Forwarded-For (Nginx local)
TRUSTED_PROXY=
PROXY_FIX_X_FOR=0

# Journaux (supervision, voir README §7.2)
# LOG_LEVEL=INFO
# LOG_FORMAT=plain        # développement : format lisible (défaut : JSON en production)
# LOG_FILE=/var/log/foyz/app.log   # en plus de stderr (rotation 10 Mo x 5)

# Sauvegardes (voir README §7.1) — utilisées par python -m ops.backup/restore
# BACKUP_DIR=/srv/backups/foyz
# BACKUP_OFFSITE=backup@ailleurs:/srv/foyz-backups
# BACKUP_PG_CONTAINER=foyz-db-1
# BACKUP_UPLOADS_CONTAINER=foyz-web-1:/data/uploads
# Chiffrement des sauvegardes (GnuPG AES-256) : fichier de phrase de passe
# en 600, conservé hors du serveur et jamais commité.
# BACKUP_PASSPHRASE_FILE=/etc/foyz/backup.passphrase

# Rétention des archives de migration (jours, défaut 30)
# ARCHIVE_RETENTION_DAYS=30
