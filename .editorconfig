# Configuration d'édition commune au dépôt.
# Documentation : https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Front-end et fichiers de configuration : indentation de 2 espaces.
[*.{html,css,js,json,yml,yaml,md}]
indent_size = 2

# Python : 4 espaces, largeur alignée sur ruff (pyproject.toml).
[*.py]
indent_size = 4
max_line_length = 100

# Scripts shell : 2 espaces.
[*.sh]
indent_size = 2

# Les recettes Makefile exigent des tabulations.
[Makefile]
indent_style = tab

# En Markdown, deux espaces en fin de ligne peuvent signifier un saut de ligne.
[*.md]
trim_trailing_whitespace = false
